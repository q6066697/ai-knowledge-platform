# DATABASE_URL — used by the running app. TEST_DATABASE_URL — used only by
# pytest (see conftest.py), must point at a SEPARATE database: the test
# suite deletes all documents/chunks in whatever DB it connects to.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_platform
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_platform_test
OPENAI_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.0

EMBEDDING_BATCH_SIZE=100

ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
RRF_K=60
RERANK_CANDIDATES=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
